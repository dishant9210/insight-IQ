GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# comma separated
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

UPLOAD_DIR=uploads

# leave unset to use a SQLite file in UPLOAD_DIR
# DATABASE_URL=postgresql://insightiq:insightiq@localhost:5432/insightiq
# set to parse uploads on a separate worker (python -m app.worker) and to
# share the answer cache and rate limits between api replicas
# REDIS_URL=redis://localhost:6379/0
MAX_UPLOAD_MB=50
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=20
# uploaded datasets are deleted after this many hours (0 = keep)
DATASET_TTL_HOURS=24
# repeat questions are answered from cache for this long (0 = off)
ANSWER_CACHE_TTL_SECONDS=3600
# per client, e.g. 20/minute,200/day (empty = no limit)
RATE_LIMIT_QUERY=20/minute,200/day
RATE_LIMIT_UPLOAD=10/minute,100/day
# behind a proxy, the header it puts the real client IP in
# CLIENT_IP_HEADER=Fly-Client-IP
# question embeddings for few-shot retrieval: hash (no model) or fastembed
EMBEDDER=hash
FEW_SHOT_K=3
SCHEMA_MAX_TABLES=6
