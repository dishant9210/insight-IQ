GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# comma separated
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

UPLOAD_DIR=uploads

# leave unset to use a SQLite file in UPLOAD_DIR
# DATABASE_URL=postgresql://insightiq:insightiq@localhost:5432/insightiq
# set to parse uploads on a separate worker (python -m app.worker)
# REDIS_URL=redis://localhost:6379/0
MAX_UPLOAD_MB=50
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=20
# uploaded datasets are deleted after this many hours (0 = keep)
DATASET_TTL_HOURS=24
