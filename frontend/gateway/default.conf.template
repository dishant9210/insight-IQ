# The gateway: one origin for the app and the api.
#
#   /          the built React app
#   /api/      proxied to the api, with a request id, the client's address and
#              the shared gateway token; sign-in routes get a tighter limit
#   /healthz   the gateway itself
#
# ${VARS} are filled in from the environment when the container starts
# (see the Dockerfile for defaults).

# the real client address when there's a proxy in front (Fly), for logs and limits
set_real_ip_from ${TRUSTED_PROXIES};
set_real_ip_from ${TRUSTED_PROXIES_V6};
real_ip_header ${REAL_IP_HEADER};

# first line of defence; the api keeps its own per-account limits in Redis
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_status 429;
limit_conn_zone $binary_remote_addr zone=conns:10m;

log_format gateway escape=json
  '{"ts":"$time_iso8601","request_id":"$request_id","client":"$remote_addr",'
  '"method":"$request_method","uri":"$request_uri","status":$status,'
  '"bytes":$body_bytes_sent,"duration":$request_time,'
  '"upstream":"$upstream_addr","upstream_duration":"$upstream_response_time",'
  '"user_agent":"$http_user_agent"}';

server {
    listen 80;
    server_tokens off;
    access_log /dev/stdout gateway;

    root /usr/share/nginx/html;
    index index.html;

    resolver ${RESOLVER} valid=10s;
    client_max_body_size ${MAX_BODY_SIZE};
    limit_conn conns 20;

    gzip on;
    gzip_types application/json application/javascript text/css image/svg+xml;
    gzip_min_length 1024;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/auth/ {
        limit_req zone=auth burst=5 nodelay;
        include /etc/nginx/conf.d/api-proxy.inc;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        include /etc/nginx/conf.d/api-proxy.inc;
    }

    location /assets/ {
        # file names carry a content hash, so they never change
        include /etc/nginx/snippets/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        include /etc/nginx/snippets/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
