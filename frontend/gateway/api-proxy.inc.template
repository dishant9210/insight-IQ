# a variable upstream is resolved at request time, so the gateway starts (and
# recovers) even while the api is down or moves
set $api ${API_UPSTREAM};
proxy_pass $api;
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_ssl_server_name on;

proxy_set_header X-Request-ID $request_id;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
# proves X-Real-IP came from here; empty = header not sent
proxy_set_header X-Gateway-Token "${GATEWAY_TOKEN}";

# a question can wait on the model for a while
proxy_connect_timeout 10s;
proxy_read_timeout 90s;
proxy_send_timeout 90s;
# stream uploads straight through instead of spooling them to disk first
proxy_request_buffering off;

# the api echoes the id too; send it once
proxy_hide_header X-Request-ID;
add_header X-Request-ID $request_id always;
include /etc/nginx/snippets/security-headers.inc;
